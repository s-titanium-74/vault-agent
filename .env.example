VAULT_AGENT_VAULT_ROOT=/path/to/your/vault
VAULT_AGENT_SERVER_ENDPOINT=http://127.0.0.1:8787
VAULT_AGENT_SERVER_HOST=127.0.0.1
VAULT_AGENT_SERVER_PORT=8787
VAULT_AGENT_API_KEY=
VAULT_AGENT_LOG_LEVEL=info
VAULT_AGENT_INDEX_DIR=
VAULT_AGENT_EMBEDDING_ENABLED=false
VAULT_AGENT_EMBEDDING_ENDPOINT=http://127.0.0.1:11434/v1/embeddings
VAULT_AGENT_EMBEDDING_MODEL=
VAULT_AGENT_EMBEDDING_REQUIRE=false
VAULT_AGENT_EMBEDDING_ALLOW_PRIVATE_NETWORK_ENDPOINT=false
VAULT_AGENT_CORS_ENABLED=false
VAULT_AGENT_CORS_ALLOWED_ORIGINS=
VAULT_AGENT_GIT_SSH_PRIVATE_KEY=
VAULT_AGENT_GIT_SSH_KNOWN_HOSTS=

# docker-compose.yml (see docs/dogfooding-guide.md). Read-only by default.
VAULT_AGENT_IMAGE=namka0703/vault-agent:0.2.0
VAULT_AGENT_HOST_VAULT_DIR=C:/Users/you/pCloud Sync/Notes
VAULT_AGENT_READ_KEY=
# Admin key is required by the server alongside the read key (distinct, 32+ chars).
# Keep it private; it is not needed by clients while writes are disabled.
VAULT_AGENT_ADMIN_KEY=
VAULT_AGENT_WRITE_ENABLED=false
VAULT_AGENT_WRITE_MODE=review
VAULT_AGENT_VAULT_MOUNT_MODE=ro
CLOUDFLARE_TUNNEL_TOKEN=
