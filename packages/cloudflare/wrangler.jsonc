{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vault-agent-synthetic",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "limits": { "cpu_ms": 1000 },
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vault-agent-synthetic",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "r2_buckets": [
    { "binding": "SOURCE", "bucket_name": "vault-agent-synthetic" },
  ],
  "vars": {
    "INGESTION_ENABLED": "true",
    "EXTERNAL_EMBEDDING_CONSENT": "false",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "EMBEDDING_MODEL_REVISION": "operator-v1",
    "VAULT_ID": "00000000-0000-4000-8000-000000000001",
    "INCLUDE_PATHS": "[\".\"]",
    "EXCLUDE_PATHS": "[]",
    "ALLOWED_ORIGINS": "[]",
    "PROFILE_VALUE_ALLOWLIST": "[\"type\",\"status\"]",
  },
  // Explicit semantic deployment. Base local development needs no AI service.
  "env": {
    "semantic": {
      "name": "vault-agent-synthetic-semantic",
      "triggers": { "crons": ["* * * * *"] },
      "ai": { "binding": "AI" },
      "vectorize": [
        {
          "binding": "VECTORS",
          "index_name": "vault-agent-synthetic-semantic",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vault-agent-synthetic",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        { "binding": "SOURCE", "bucket_name": "vault-agent-synthetic" },
      ],
      "ratelimits": [
        {
          "name": "REQUEST_LIMITER",
          "namespace_id": "1001",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "vars": {
        "INGESTION_ENABLED": "true",
        "EXTERNAL_EMBEDDING_CONSENT": "true",
        "EMBEDDING_MODEL": "@cf/baai/bge-m3",
        "EMBEDDING_MODEL_REVISION": "operator-v1",
        "VAULT_ID": "00000000-0000-4000-8000-000000000001",
        "INCLUDE_PATHS": "[\".\"]",
        "EXCLUDE_PATHS": "[]",
        "ALLOWED_ORIGINS": "[]",
        "PROFILE_VALUE_ALLOWLIST": "[\"type\",\"status\"]",
      },
    },
  },
}
